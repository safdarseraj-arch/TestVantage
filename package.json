{
  "name": "testvantage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TestVantage question bank and OCR upload",
  "scripts": {
    "server:start": "node scripts/dev-background.mjs",
    "api": "node server/index.js",
    "api:start": "node scripts/api-background.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "stack:up": "node scripts/stack-compose.mjs up",
    "stack:down": "node scripts/stack-compose.mjs down",
    "stack:logs": "node scripts/stack-compose.mjs logs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "pix2text:up": "docker compose -f deploy/docker-compose.pix2text.local.yml up -d --build",
    "pix2text:down": "docker compose -f deploy/docker-compose.pix2text.local.yml down",
    "pix2text:logs": "docker compose -f deploy/docker-compose.pix2text.local.yml logs -f",
    "pix2text:start": "node scripts/pix2text-background.mjs",
    "live:build": "node scripts/live-build.mjs",
    "live:up": "npm run stack:up",
    "live:deploy": "node scripts/deploy-live.mjs",
    "test:platform-live": "node scripts/test-platform-auth.mjs",
    "server:stop": "node scripts/stop-dev.mjs",
    "dev": "node scripts/launch-dev.mjs",
    "dev:vite": "vite",
    "dev:status": "node scripts/dev-status.mjs",
    "dev:open": "node scripts/open-or-start.mjs",
    "dev:stop": "node scripts/stop-dev.mjs",
    "start": "node scripts/launch-dev.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:upload": "node scripts/test-upload-pipeline.mjs",
    "test:regression": "node scripts/run-regression.mjs",
    "test:matrix": "node scripts/test-matrix-save-stem.mjs",
    "test:integrity": "node scripts/check-src-integrity.mjs",
    "test:syntax": "node scripts/check-src-syntax.mjs",
    "test:builtin-ocr": "node scripts/test-builtin-ocr.mjs",
    "test:upload-gate": "npm run test:syntax && npm run test:integrity && npm run test:matrix && npm run test:regression",
    "fetch:jee-test-images": "node scripts/fetch-jee-google-images.mjs",
    "fetch:jee-test-images:sample": "node scripts/fetch-jee-google-images.mjs --sample",
    "fetch:official-pyq": "node scripts/fetch-official-pyq.mjs",
    "test:official-pyq": "node scripts/test-official-pyq-approval.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.4",
    "redis": "^4.7.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "vite": "^6.4.3"
  }
}
