# Production — copy to .env.production before: npm run live:deploy
# Never commit real secrets. Change every CHANGE_ME / default password.

# Client — enables server auth, sync, exam autosave
# Demo seeds stay off (do not set VITE_ALLOW_DEMO_SEED).
VITE_PLATFORM_SCALE=1
VITE_API_BASE=/api
VITE_EXAM_AUTOSAVE_MS=5000

# Postgres (must match POSTGRES_PASSWORD below and docker-compose)
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgres://tv:CHANGE_ME_strong_db_password@postgres:5432/testvantage
REDIS_URL=redis://redis:6379
TESTVANTAGE_REQUIRE_POSTGRES=1
TESTVANTAGE_REQUIRE_REDIS=1
TESTVANTAGE_API_HOST=0.0.0.0
TESTVANTAGE_API_PORT=3001

# CORS — set to your public website origin (not * on the open internet)
TESTVANTAGE_CORS_ORIGIN=https://your-domain.com

# Live admin login (change before public go-live!)
TESTVANTAGE_ADMIN_EMAIL=admin@testvantage.com
TESTVANTAGE_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
TESTVANTAGE_ADMIN_NAME=Admin

# Cloud AI — Gemini only (server-side; never VITE_*)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash
TESTVANTAGE_VISION_PROVIDER=gemini

# Mathpix OCR (server-side; never VITE_*)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Pix2Text formula OCR (included in Docker stack)
PIX2TEXT_URL=http://pix2text:8503
PIX2TEXT_ENABLED=auto
