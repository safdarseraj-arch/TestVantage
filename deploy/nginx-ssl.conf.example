# HTTPS nginx example — use with Let's Encrypt on your cloud server.
# 1. Point your domain DNS to the server IP.
# 2. Obtain certs (e.g. certbot certonly --nginx -d yourdomain.com).
# 3. Mount certs into nginx and use this config instead of nginx.conf.

worker_processes auto;

events {
  worker_connections 4096;
}

http {
  upstream testvantage_api {
    least_conn;
    server api1:3001;
    server api2:3001;
  }

  server {
    listen 80;
    server_name yourdomain.com;
    return 301 https://$host$request_uri;
  }

  server {
    listen 443 ssl http2;
    server_name yourdomain.com;

    ssl_certificate     /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 25m;

    location /api/ {
      proxy_pass http://testvantage_api;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 5s;
      proxy_read_timeout 120s;
    }

    location / {
      root /usr/share/nginx/html;
      try_files $uri $uri/ /index.html;
    }
  }
}
