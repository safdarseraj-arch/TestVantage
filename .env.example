# TestVantages FastAPI backend (main.py) — Hybrid AI module, same stack as onlinetest
# Copy to .env next to this file. Never commit .env (it is gitignored).

# Google Gemini API key for AI question generation (GOOGLE_API_KEY also works).
GEMINI_API_KEY=your-gemini-api-key-here

# Async Postgres URL for SQLAlchemy + pgvector (local default).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/testvantages

# --- TestVantages Node API / optional services (see server/) ---
# Local OCR always works without extra keys.
# GEMINI_API_KEY=your-gemini-api-key-here
# Optional aliases: GOOGLE_GENERATIVE_AI_API_KEY= or GOOGLE_API_KEY=
# OPENAI_API_KEY=

# --- Mathpix OCR (required for PDF / image / handwriting extract) ---
# Server only. Never use VITE_MATHPIX_* (that would bake keys into the website).
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
# GEMINI_VISION_MODEL=gemini-3.5-flash
# Photos / scans only — Flash-Lite tried first, Flash if Lite fails (default on):
# GEMINI_VISION_PREFER_LITE=1
# GEMINI_VISION_LITE_MODEL=gemini-3.5-flash-lite
# Text-only JSON (after Mathpix LaTeX): structure OCR, Re-parse, SCQ trial, assist:
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Optional cheaper model for the 10-SCQ-per-chapter trial:
# GEMINI_SCQ_TRIAL_MODEL=gemini-3.5-flash-lite
# Cap output tokens (output = 91% of spend). Defaults: structure 6144, SCQ 4096, assist 6144.
# GEMINI_STRUCTURE_MAX_OUTPUT=6144
# GEMINI_SCQ_TRIAL_MAX_OUTPUT=4096
# GEMINI_ASSIST_MAX_OUTPUT=6144
# Clone scaled jobs: bundle style guide / reference file and use Gemini context cache when beneficial:
# BATCH_OPTIMIZE=true

# Prompt caching for repeated system prompts (structure OCR chunks, SCQ trial):
# GEMINI_PROMPT_CACHE=1
# GEMINI_CACHE_TTL_SEC=3600
# OPENAI_VISION_MODEL=gpt-4o
# TESTVANTAGE_VISION_PROVIDER=auto

# --- Pix2Text formula OCR sidecar (optional, self-hosted) ---
# Local Cursor: npm run pix2text:up  (Docker on port 8503)
# Production stack: included in deploy/docker-compose.yml as pix2text service
# PIX2TEXT_ENABLED=auto
# PIX2TEXT_URL=http://127.0.0.1:8503
# F5 / npm run server:start also tries: npm run pix2text:start (Docker if available)
# Docker production (auto-set in compose): PIX2TEXT_URL=http://pix2text:8503
# PIX2TEXT_TIMEOUT_MS=120000

# --- API server ports / bind ---
# TESTVANTAGE_API_PORT=3001
# TESTVANTAGE_API_HOST=127.0.0.1
# For Docker / public host: TESTVANTAGE_API_HOST=0.0.0.0


# --- Public site URL (Vite build — print sheets, watermarks; optional locally) ---
# VITE_PUBLIC_SITE_URL=https://www.testvantages.com

# --- CORS (production: set to your public site origin(s)) ---
# Local Cursor / Vite: leave unset or *
# TESTVANTAGE_CORS_ORIGIN=*
# Node API — comma-separated allowlist:
# TESTVANTAGE_CORS_ORIGIN=https://www.testvantages.com,https://testvantages.com
# FastAPI Hybrid AI (port 8000) — optional override; defaults include local + production domains:
# TESTVANTAGE_CORS_ORIGINS=https://www.testvantages.com,https://testvantages.com

# --- Admin login (change before public go-live!) ---
# TESTVANTAGE_ADMIN_EMAIL=admin@testvantages.com
# TESTVANTAGE_ADMIN_PASSWORD=change-this-strong-password
# TESTVANTAGE_ADMIN_NAME=Admin

# --- Optional Postgres / Redis (Node API scale stack) ---
# DATABASE_URL=postgres://tv:CHANGE_ME@127.0.0.1:5432/testvantage
# REDIS_URL=redis://127.0.0.1:6379
# TESTVANTAGE_REQUIRE_POSTGRES=0
# TESTVANTAGE_REQUIRE_REDIS=0

# --- Product mode (live is the default) ---
# Demo PYQ catalog / seed leaderboard stay OFF.
# Staff-only: restore local demo seeds with:
# VITE_ALLOW_DEMO_SEED=1
# Never set this in production.

# Do NOT put secrets in VITE_* variables — Vite embeds them in browser JS.
# Legacy Mathpix is off by default; use Admin → OCR settings if you must.
